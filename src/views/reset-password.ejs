<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AuthX - Reset Password</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="page-shell">
    <div class="auth-panel">
      <div>
        <span class="eyebrow">Reset Password</span>
        <h1>Choose a new password</h1>
        <p class="subtitle">Enter the reset token and the new password for your account.</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/reset-password" class="form">
        <label for="token">Reset Token</label>
        <input
          id="token"
          name="token"
          type="text"
          placeholder="Paste your reset token"
          required
        />

        <label for="newPassword">New Password</label>
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          placeholder="Example: NewStrongPass1!"
          required
        />

        <button type="submit">Reset Password</button>
      </form>

      <div class="links">
        <a href="/forgot-password">Back to forgot password</a>
        <a href="/login">Back to login</a>
      </div>
    </div>
  </div>
</body>
</html>
