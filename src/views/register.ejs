<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AuthX - Register</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="page-shell">
    <div class="auth-panel">
      <div>
        <span class="eyebrow">Registration</span>
        <h1>Create account</h1>
        <p class="subtitle">Create a new account for the internal portal.</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/register" class="form">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="new.user@authx.com"
          required
        />

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Example: StrongPass1!"
          required
        />

        <label for="role">Role</label>
        <select id="role" name="role">
          <option value="ANALYST">ANALYST</option>
          <option value="MANAGER">MANAGER</option>
        </select>

        <button type="submit">Create Account</button>
      </form>

          <div class="hint-box">Password must contain at least 10 characters, one uppercase letter, one lowercase letter, one number and one special character.</div>

      <div class="links">
        <a href="/login">Back to login</a>
      </div>
    </div>
  </div>
</body>
</html>
