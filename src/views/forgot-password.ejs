<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AuthX - Forgot Password</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="page-shell">
    <div class="auth-panel">
      <div>
        <span class="eyebrow">Password Reset</span>
        <h1>Reset your password</h1>
        <p class="subtitle">Enter your email address to continue.</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (resetToken) { %>
        <div class="alert alert-success">
          Reset token: <strong><%= resetToken %></strong>
        </div>
      <% } %>

      <form method="POST" action="/forgot-password" class="form">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="Enter email"
          required
        />

        <button type="submit">Generate Reset Token</button>
      </form>

      <div class="links">
        <a href="/login">Back to login</a>
        <a href="/reset-password">Go to reset page</a>
      </div>
    </div>
  </div>
</body>
</html>
